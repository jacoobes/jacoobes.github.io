<div class="{{ slug }}">
    <nav class="project-nav">
        {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← prev</a>{% endif %}
        <a class="link-style back" href="/">home</a>
        {% if pagination.href.next %}<a href="{{ pagination.href.next }}">next →</a>{% endif %}
    </nav>

    <p class="project-idx">{{ pagination.pageNumber | padzero }}</p>

    <div class="project-meta">
        <p class="meta-label">(name)</p>
        <p class="meta-value">{{ project.name }}</p>

        <p class="meta-label">(type)</p>
        <p class="meta-value">{{ project.des }}</p>

        {% if project.link %}
            <p class="meta-label">(link)</p>
            <a class="project-link meta-value" href="{{ project.link }}" target="_blank" rel="noopener">View source ↗</a>
        {% endif %}
    </div>

    {% if project.long %}
        <p class="project-long">{{ project.long }}</p>
    {% endif %}

    <h1 class="project-title">{{ project.name }}</h1>
</div>

<div class="{{ slug }}-2">
    <div class="lb-text">
        <p class="lb-desc">Coding is easy for this college student, but falling in love is hard! <br>

        Date four programming languages. In this romance visual novel, explore each language's life.</p>
    </div>

    <div class="lb-slideshow" data-slideshow>
        <div class="lb-slides">
            <img sizes="50vw" class="lb-slide" src="/img/draft.jpg" alt="Draft — LoveBytes">
            <img sizes="50vw" class="lb-slide is-active" src="/img/cpp.png" alt="C++ — LoveBytes">
            <img sizes="50vw" class="lb-slide" src="/img/java.png" alt="Java — LoveBytes">
            <img sizes="50vw" class="lb-slide" src="/img/lisp.png" alt="Lisp — LoveBytes">
            <img sizes="50vw" class="lb-slide" src="/img/py.png" alt="Python — LoveBytes">
        </div>
        <div class="lb-controls">
            <button class="lb-prev" type="button" aria-label="Previous image">← prev</button>
            <span class="lb-counter">01 / 05</span>
            <button class="lb-next" type="button" aria-label="Next image">next →</button>
        </div>
    </div>
</div>

