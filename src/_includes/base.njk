<!doctype html>

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "PORTFOLIO jacoobes" }}</title>
    <link rel="stylesheet" href="/style.css">
    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
</head>
<body class="{{ bodyClass }}">
    <main class="project-detail">
        <nav class="project-nav">
                {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← prev</a>{% endif %}
                <a class="link-style back" href="/">home</a>
                {% if pagination.href.next %}<a href="{{ pagination.href.next }}">next →</a>{% endif %}

        </nav>
        {{ content | safe }}
    </main>
<script src="/index.js"></script>
</body>
</html>
