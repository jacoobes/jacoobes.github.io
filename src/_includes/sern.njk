

<div class="{{slug}}">
    <nav class="project-nav">
        {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← prev</a>{% endif %}
        <a class="link-style back" href="/">home</a>
        {% if pagination.href.next %}<a href="{{ pagination.href.next }}">next →</a>{% endif %}
    </nav>

    <div class="project-meta">
        <p>(name)</p>
        <p class="project-name">{{ project.name }}</p>


        <p>(link)</p>
        {% if project.link %}
        <a class="project-link" href="{{ project.link }}" target="_blank" rel="noopener">View source ↗</a>
        {% else %}
        <span class="project-link"></span>
        {% endif %}        
        </div>
    {% if project.long %}
        <p class="project-long">{{ project.long  }} </p>
    {% endif %}
</div>
